# Copiá este archivo como .env y completá los valores
# NUNCA subas .env a GitHub

TELEGRAM_BOT_TOKEN=tu_token_aqui
EMAIL_ADDRESS=tu_email@gmail.com
EMAIL_PASSWORD=tu_app_password_de_gmail
CC_EMAIL=email_copia_opcional@gmail.com
OPENAI_API_KEY=tu_api_key_de_openai

# Google (extract_reports.py, gmail_quickstart.py): el JSON completo en una sola línea
GOOGLE_OAUTH_CLIENT_JSON={"installed":{...}}
GMAIL_TOKEN_JSON={"token":"...","refresh_token":"...",...}
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
HEROKU_API_KEY=tu_api_key_de_heroku   # scripts/generate_daily_code.py

# Código diario de administrador: lo escribe scripts/generate_daily_code.py en Heroku (no se carga a mano)
ADMIN_DAILY_CODE=
# Destrabe de pasos de foto con el código del encargado (opcionales, estos son los valores por defecto)
# Códigos incorrectos seguidos antes de bloquear, y minutos de bloqueo
DESTRABE_MAX_INTENTOS=5
DESTRABE_MINUTOS_BLOQUEO=15
# Revisión con IA de las fotos de reparaciones (usa OPENAI_API_KEY). Opcionales, valores por defecto:
# VISION_ACTIVA=0 la apaga (las fotos quedan "sin validar" y no se traba a nadie)
VISION_ACTIVA=1
VISION_MODEL=gpt-6-luna
# Segundos máximos por foto; si la API tarda más, la foto queda "sin validar"
VISION_TIMEOUT_S=20
# Esfuerzo de razonamiento del modelo (none, low, medium, high)
VISION_REASONING=low
# Distancia de huella visual para tomar dos fotos como la misma (reenviada o ráfaga)
PHASH_THRESHOLD=8
# Datos para entrenar la IA (opcional): hoja de Google Sheets compartida como Editor con la cuenta
# de servicio de GOOGLE_SERVICE_ACCOUNT_JSON. Sin esto no se guarda nada.
DATASET_SHEET_ID=
DATASET_SHEET_NAME=Fotos
# Fotos de referencia de bot/referencias/: cuántas por elemento y con qué detalle se mandan
VISION_MAX_REF=10
VISION_REF_DETAIL=low
